# Copy to deploy/.env on the server and fill in (see deploy/README.md).

# caddy (HTTPS on this server, ports 80 and 443 open) or tunnel (Cloudflare Tunnel).
COMPOSE_PROFILES=caddy

DOSSIER_DOMAIN=job.mrahmadusama.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
DOSSIER_SECRET=
# docker run --rm -it dossier:local hash-password  (one line, starts with argon2id:)
DOSSIER_PASSWORD=

# Your time zone, e.g. Asia/Karachi: nightly backups run at 03:00 in it.
TZ=

# Only with COMPOSE_PROFILES=tunnel: the token from Cloudflare Zero Trust → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Gmail and Calendar, the Claude connector, and FreeHire as a job source stay
# hidden unless switched on. FreeHire's free use is for personal job search; a
# hosted service needs one of its API plans (freehire.me/terms).
# DOSSIER_GOOGLE=off
# DOSSIER_CONNECTOR=off
# DOSSIER_FREEHIRE=off

# Optional defaults; all of these can also be set in the app's Settings.
# DOSSIER_AI_PROVIDER=anthropic
# DOSSIER_AI_MODEL=
# DOSSIER_AI_KEY=
